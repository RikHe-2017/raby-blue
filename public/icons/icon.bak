<svg width="128" height="128" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- 背景 -->
  <rect width="128" height="128" rx="20" fill="#7C3AED" />
  
  <!-- 兔子头部 -->
  <circle cx="64" cy="60" r="28" fill="white" />
  
  <!-- 耳朵 -->
  <ellipse cx="50" cy="35" rx="6" ry="18" fill="white" />
  <ellipse cx="78" cy="35" rx="6" ry="18" fill="white" />
  
  <!-- 内耳 -->
  <ellipse cx="50" cy="35" rx="4" ry="14" fill="#F3E8FF" />
  <ellipse cx="78" cy="35" rx="4" ry="14" fill="#F3E8FF" />
  
  <!-- 眼睛 -->
  <circle cx="56" cy="55" r="3" fill="#7C3AED" />
  <circle cx="72" cy="55" r="3" fill="#7C3AED" />
  
  <!-- 鼻子 -->
  <circle cx="64" cy="62" r="1.5" fill="#7C3AED" />
  
  <!-- 嘴巴 -->
  <path d="M64 66 Q60 70 64 74" stroke="#7C3AED" stroke-width="2" fill="none" />
</svg>
