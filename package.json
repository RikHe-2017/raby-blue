{
  "name": "RabyBlue",
  "private": true,
  "version": "1.0.0",
  "description": "Browser request proxy and JavaScript script manager built with Vue 3 and Manifest V3",
  "author": "RikHe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RikHe-2017/raby-blue.git"
  },
  "homepage": "https://github.com/RikHe-2017/raby-blue#readme",
  "bugs": {
    "url": "https://github.com/RikHe-2017/raby-blue/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "vue-tsc --noEmit -p tsconfig.test.json",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:dev": "vue-tsc -b && vite build --mode development",
    "build:extension": "npm run build && node scripts/build-extension.js",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "test:config-transfer": "vitest run src/components/config-transfer/transfer.test.ts",
    "test:proxy-sidebar": "vitest run src/components/proxy/sidebar-projections.test.ts src/stores/proxy-rules.test.ts",
    "test:user-preferences": "vitest run src/stores/user-preferences.test.ts",
    "test:document-response": "vitest run src/document-response.test.ts src/response-connection.test.ts src/proxy-strategies.test.ts src/debugger-cancellation.test.ts",
    "test:proxy-headers": "vitest run src/proxy/header-settings.test.ts src/components/proxy/header-drafts.test.ts",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@element-plus/icons-vue": "^2.3.1",
    "@types/chrome": "^0.0.323",
    "element-plus": "^2.9.10",
    "pinia": "^3.0.2",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.31.0",
    "@iconify-json/ep": "^1.2.3",
    "@types/node": "^22.15.19",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "archiver": "^7.0.1",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-vue": "^10.3.0",
    "fake-indexeddb": "^6.2.7",
    "sharp": "^0.34.1",
    "typescript": "~5.8.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.8"
  }
}
