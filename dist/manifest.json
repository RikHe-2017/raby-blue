{
  "manifest_version": 3,
  "minimum_chrome_version": "125",
  "name": "RabyBlue",
  "short_name": "蓝兔",
  "version": "1.0.0",
  "description": "蓝兔是一个为 WEB 研发调试打造的浏览器扩展，可按规则重定向请求、修改请求头和响应头，并管理和执行常用 JavaScript 调试脚本。",
  "homepage_url": "https://github.com/RikHe-2017/raby-blue",
  "permissions": [
    "alarms",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "debugger",
    "webNavigation",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
